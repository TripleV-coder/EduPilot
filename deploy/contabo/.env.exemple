# EduPilot — variables de PRODUCTION sur VPS (copier en .env à la racine du dépôt,
# mode 600). install.sh génère ce fichier automatiquement ; ce modèle documente.

# Adresse publique (le DNS doit pointer vers le VPS)
DOMAIN=app.mon-ecole.bj
NEXTAUTH_URL=https://app.mon-ecole.bj

# Secret maître : toutes les clés techniques en dérivent (openssl rand -base64 48)
# ⚠️ À conserver précieusement : le changer rend illisibles les secrets chiffrés.
NEXTAUTH_SECRET=

# PostgreSQL : propriétaire (migrations, sauvegardes) et rôle applicatif (RLS)
POSTGRES_USER=edupilot
POSTGRES_DB=edupilot
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Processus serveur (2 pour un VPS de 4 vCPU)
WEB_CONCURRENCY=2

# Le reste (e-mail, WhatsApp, SMS, paiements) se règle dans la console root.
