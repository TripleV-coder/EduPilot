# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edupilot?schema=public"

# ===========================================
# NEXTAUTH.JS
# ===========================================
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-secret-with-openssl-rand-base64-32"

# ===========================================
# APPLICATION
# ===========================================
NEXT_PUBLIC_APP_NAME="EduPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# EMAIL SERVICE (Optional - for password reset)
# ===========================================
# Supported providers: resend, sendgrid, smtp
# EMAIL_PROVIDER=smtp
# EMAIL_API_KEY="" # not needed for smtp
# EMAIL_FROM=noreply@yourdomain.com

# Configuration SMTP (Si EMAIL_PROVIDER="smtp")
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="votre_email@gmail.com"
# SMTP_PASS="votre_mot_de_passe_app"
# SMTP_SECURE="false" # true pour le port 465, false pour 587

# ===========================================
# SÉCURITÉ 2FA — CHIFFREMENT TOTP (REQUIS si 2FA activé)
# ===========================================
# Clé AES-256 pour chiffrer les secrets TOTP en base de données
# Générer avec : openssl rand -hex 32
TOTP_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# ===========================================
# PAIEMENTS (requis pour les webhooks en production)
# ===========================================
# Clé secrète webhook Flutterwave (depuis le dashboard Flutterwave)
# FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
# Clé secrète Flutterwave pour les appels API
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxx
# Clé publique Flutterwave
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxx
# Clé secrète Paystack (si utilisé)
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx

# ===========================================
# CRON JOBS (requis si appel automatisé de /api/system/retention)
# ===========================================
# Secret partagé avec le scheduler pour les appels cron authentifiés
# Générer avec : openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# ===========================================
# REDIS / RATE LIMITING (optionnel, recommandé en production)
# ===========================================
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ===========================================
# MONITORING (optionnel)
# ===========================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===========================================
# ALERTES PERFORMANCE (optionnel)
# ===========================================
# Email pour recevoir les alertes performance (LCP, erreurs API, etc.)
# PERFORMANCE_ALERT_EMAIL=admin@yourdomain.com
# Webhook Slack pour notifications (format: https://hooks.slack.com/services/...)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Analytics produit (Web Vitals → /api/analytics/web-vitals, PerformanceMetric)
# Mettre à "true" pour activer l'envoi des Core Web Vitals depuis le navigateur
NEXT_PUBLIC_ANALYTICS_ENABLED="false"

# ===========================================
# MTN MOMO (optionnel — décaissements Mobile Money)
# ===========================================
# Portail développeur : https://momodeveloper.mtn.com
# Webhook URL à enregistrer : https://votre-domaine.com/api/payments/momo/webhook
# MOMO_WEBHOOK_SECRET=your-hmac-secret
# MOMO_SUBSCRIPTION_KEY=your-subscription-key
# MOMO_API_USER=uuid-api-user
# MOMO_API_KEY=your-api-key
# MOMO_BASE_URL=https://proxy.momoapi.mtn.com

# ===========================================
# FEDAPAY (paiement en ligne — Mobile Money MTN/Moov/Celtiis + cartes)
# ===========================================
# Tableau de bord : https://fedapay.com  (clés : Workbench → API)
# Webhook URL à enregistrer : https://votre-domaine.com/api/payments/fedapay/webhook
# FEDAPAY_SECRET_KEY=sk_sandbox_xxx        # sk_live_… en production
# FEDAPAY_PUBLIC_KEY=pk_sandbox_xxx
# FEDAPAY_WEBHOOK_SECRET=whsec_xxx         # secret de l'endpoint webhook (vérif signature)
# FEDAPAY_ENVIRONMENT=sandbox              # "sandbox" | "live"

# ===========================================
# WHATSAPP BUSINESS API (optionnel — notifications parents)
# ===========================================
# Meta Cloud API : https://developers.facebook.com/docs/whatsapp/cloud-api
# Webhook URL à enregistrer : https://votre-domaine.com/api/webhooks/whatsapp
# WHATSAPP_PHONE_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-bearer-token
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ===========================================
# IA — PROVIDERS CLOUD & N8N (optionnel)
# ===========================================
# Cascade du chat IA : providers externes → n8n → 503 explicite.
# Providers externes (au moins un pour activer le chat sans n8n) :
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_AI_API_KEY=...
# Workflows n8n (chat + analyse prédictive) :
# N8N_HOST=https://n8n.votre-domaine.com
# N8N_WEBHOOK_KEY=header-auth-du-noeud-webhook
# N8N_WEBHOOK_SECRET=secret-hmac-signature-payload
