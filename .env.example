# ==============================================================================
# EduPilot — variables d'environnement
# ==============================================================================
# Toutes les variables lues par le code figurent ici (vérifié par
# tests/lib/config/env-documentation.test.ts). Une ligne commentée = optionnelle
# ou avec valeur par défaut. « Obligatoire en production » = le serveur refuse de
# démarrer sans elle (src/lib/env.ts, validateEnv).
# Ne jamais commiter le fichier .env réel.

# ===========================================
# BASE DE DONNÉES — obligatoire
# ===========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edupilot?schema=public"
# Connexions PostgreSQL PAR PROCESSUS serveur (défaut 10 ; `connection_limit=`
# dans l'URL reste prioritaire). Total = WEB_CONCURRENCY × DATABASE_POOL_SIZE ×
# instances (+ n8n, sauvegardes) : à garder sous max_connections de PostgreSQL
# (100 par défaut), sinon PgBouncer en mode transaction devant la base.
# DATABASE_POOL_SIZE=10

# ===========================================
# AUTHENTIFICATION (Auth.js / NextAuth v5)
# ===========================================
# Obligatoire. Générer : openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-secret-with-openssl-rand-base64-32"
# Obligatoire en production : URL publique exacte de l'application.
NEXTAUTH_URL="http://localhost:3000"
# Auto-hébergement (next start / node server.js) : Auth.js refuse les requêtes
# (« UntrustedHost ») tant que ce n'est pas "true". Derrière un reverse proxy,
# celui-ci doit transmettre l'en-tête Host d'origine.
# AUTH_TRUST_HOST=true
# Obligatoire en production. Clé AES-256 des secrets 2FA. Générer : openssl rand -hex 32
TOTP_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# ===========================================
# APPLICATION
# ===========================================
NEXT_PUBLIC_APP_NAME="EduPilot"
# URL publique (liens des emails, redirections) — HTTPS en production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Adresse de contact affichée dans /privacy et /terms.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@votre-domaine.com
# Envoi des Core Web Vitals depuis le navigateur vers /api/analytics/web-vitals.
NEXT_PUBLIC_ANALYTICS_ENABLED="false"

# ===========================================
# RÉSEAU — ADRESSE IP DU CLIENT (rate-limit, journaux)
# ===========================================
# Le serveur doit être lancé avec le préchargement qui fournit l'adresse réelle
# de la connexion (npm run start et l'image Docker le font) :
#   node --require ./scripts/server/client-ip-preload.cjs .next/standalone/server.js
# Il pose lui-même EDUPILOT_PEER_TOKEN (obligatoire en production) — ne pas la définir :
# EDUPILOT_PEER_TOKEN=
#
# Nombre de reverse proxys de confiance DEVANT l'application :
#   0 (défaut) : aucun — l'application est exposée directement ; X-Forwarded-For
#                fourni par le client est ignoré.
#   1          : un nginx/Caddy/Traefik qui AJOUTE l'IP du client à X-Forwarded-For
#                (nginx : proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;).
#                Le port de l'application ne doit alors être joignable QUE par ce proxy
#                (écoute sur 127.0.0.1 ou réseau Docker interne), sinon un client qui
#                le contourne choisit son IP.
# TRUSTED_PROXY_HOPS=0

# ===========================================
# RATE-LIMIT, CACHE, MIROIR DE MAINTENANCE — Upstash Redis (REST), NON UTILISÉ
# ===========================================
# Déploiement retenu (décision du 2026-09-12) : UN SEUL processus Node
# (ecosystem.config.js : fork, instances 1 ; image Docker : un processus).
# Rate-limit, compteur d'échecs de connexion et cache restent en mémoire :
# c'est exact avec une instance unique, et aucune adresse IP ne sort de la
# machine. Ne PAS lancer plusieurs instances sans magasin partagé (les limites
# seraient multipliées par le nombre de processus).
# Upstash reste pris en charge si un magasin partagé devient nécessaire ;
# lent ou injoignable, il est court-circuité (délai 200 ms, repli mémoire).
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
#
# Redis TCP auto-hébergé (OBLIGATOIRE dès 2 processus ou instances) :
# limites de débit (seaux à jetons), coupe-circuits et notifications en temps
# réel partagés entre toutes les instances. Prioritaire sur Upstash. Redis seul
# ou Sentinel (pas Redis Cluster : les seaux compte + IP sont lus ensemble).
# Injoignable → repli mémoire automatique, l'application continue.
# REDIS_URL=redis://localhost:6379

# ===========================================
# CAPACITÉ — processus serveur (analyse du 2026-10-01)
# ===========================================
# Un processus Node n'utilise qu'UN cœur pour le code applicatif (mesuré :
# saturation vers 60–120 req/s). Nombre de processus : 1, N ou « max » (un par
# cœur). Au-delà de 1, REDIS_URL est obligatoire : le lanceur refuse sinon.
# Lu par scripts/server/cluster.cjs (Docker) et ecosystem.config.js (PM2).
# WEB_CONCURRENCY=1
# Threads libuv par processus : le hachage des mots de passe (bcrypt natif) s'y
# exécute, hors du thread des requêtes. Défaut Node : 4.
# UV_THREADPOOL_SIZE=4
# Test de charge uniquement : autoriser plusieurs processus SANS Redis (limites
# multipliées par processus). Jamais en production.
# CLUSTER_ALLOW_LOCAL_LIMITS=false
# Arrêt propre (SIGTERM) : délai accordé aux requêtes en cours, puis aux
# fermetures (Prisma, Redis), en ms. kill_timeout PM2 / stop_grace_period
# Docker doivent dépasser leur somme.
# SHUTDOWN_DRAIN_TIMEOUT_MS=20000
# SHUTDOWN_TASK_TIMEOUT_MS=5000

# ===========================================
# PROTECTION CONTRE LA SURCHARGE — valeurs par défaut indiquées
# ===========================================
# Seaux à jetons, par minute : par compte connecté, et par adresse IP pour les
# appels anonymes (un compte connecté n'est limité que par son propre seau : une
# IP d'établissement ou le NAT d'un opérateur mobile est partagée par des
# centaines de personnes). Au-delà : 429 + Retry-After. (×5 en développement.)
# RATE_LIMIT_USER_PER_MIN=100
# RATE_LIMIT_IP_PER_MIN=1000
# Échecs de connexion tolérés par adresse IP en 15 min, tous comptes confondus
# (essais en masse). Par compte : 10 échecs / 15 min, fixe. Garder large : une
# école entière se connecte souvent derrière un seul routeur.
# LOGIN_IP_FAILURES_PER_15MIN=200
# File d'envoi bornée : 503 + Retry-After dès que JOB_QUEUE_MAX × RATIO tâches
# attendent, ou si un lot la ferait déborder. 20 000 couvre la relance d'impayés
# de plusieurs établissements à la fois.
# JOB_QUEUE_MAX=20000
# JOB_QUEUE_REJECT_RATIO=0.8
# Rythme du traitement de la file (par instance pour la concurrence, global
# pour le débit si REDIS_URL est configuré).
# JOB_WORKER_CONCURRENCY=5
# JOB_WORKER_RATE_PER_MIN=600
# Coupe-circuit des services externes (SMS, e-mail, paiements) : ouvert après
# N échecs consécutifs, pendant CIRCUIT_OPEN_MS ; ensuite un seul essai.
# CIRCUIT_FAILURE_THRESHOLD=5
# CIRCUIT_OPEN_MS=30000
# Métriques Prometheus sur GET /api/metrics (Authorization: Bearer <jeton>).
# Absent → la route répond 404. Générer : openssl rand -hex 32
# METRICS_TOKEN=

# ===========================================
# EMAIL — obligatoire en production (réinitialisation de mot de passe, invitations)
# ===========================================
# Fournisseurs : smtp, resend, sendgrid
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=noreply@votre-domaine.com
# Resend / SendGrid uniquement (inutile en SMTP) :
# EMAIL_API_KEY=
# SMTP (EMAIL_PROVIDER=smtp) — SMTP_HOST obligatoire en production dans ce cas :
# SMTP_HOST="smtp.votre-domaine.com"
# SMTP_PORT="587"
# SMTP_USER="votre_email@votre-domaine.com"
# SMTP_PASS="votre_mot_de_passe_app"
# SMTP_SECURE="false" # true pour le port 465, false pour 587

# ===========================================
# SIGNATURE ÉLECTRONIQUE — obligatoire en production
# ===========================================
# Sel du hachage des adresses IP enregistrées avec chaque signature.
# Générer : openssl rand -hex 32
# SIGNATURE_SALT=

# ===========================================
# TÂCHES PLANIFIÉES — /api/system/automation et /api/system/retention
# ===========================================
# Secret partagé avec le planificateur : Authorization: Bearer <CRON_SECRET>.
# Générer : openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# File d'envoi (courriels, SMS) : traitée par le serveur toutes les 5 s, en
# arrière-plan, avec nouveaux essais. Ne mettre à true que si un autre
# processus, branché sur la même base, s'en charge à la place.
# JOB_WORKER_DISABLED=false

# ===========================================
# SUPER-ADMINISTRATION « ROOT »
# ===========================================
# Restriction FACULTATIVE de l'espace root-control (emails séparés par des
# virgules, casse indifférente). Absente : tout SUPER_ADMIN y a accès — c'est
# le cas d'une installation neuve, dont le premier super-administrateur est
# créé depuis /setup. Définie : seuls les SUPER_ADMIN listés y ont accès.
# ROOT_USER_EMAILS=admin@votre-domaine.com
# Secret demandé par /api/root/auth pour ouvrir l'accès root.
# ROOT_SECRET=

# ===========================================
# SAUVEGARDE PAR API (désactivée par défaut)
# ===========================================
# Autorise POST /api/system/backup (SUPER_ADMIN), hors production :
# ALLOW_BACKUP_API=false
# …et en production (à réserver à un besoin précis) :
# ALLOW_BACKUP_API_IN_PRODUCTION=false
#
# Répertoire des sauvegardes chiffrées, lu par scripts/backup/postgres-backup.sh
# et par la page « Sauvegarde » (liste des archives) :
# BACKUP_DIR=/var/backups/edupilot/postgres
#
# Les variables suivantes ne sont lues que par les scripts de sauvegarde
# (voir docs/EXPLOITATION.md), pas par l'application :
#   BACKUP_PASSPHRASE_FILE  — fichier de la phrase secrète (mode 600). SANS ELLE,
#                             postgres-backup.sh REFUSE de tourner.
#   BACKUP_RETENTION_DAYS   — âge au-delà duquel une archive est supprimée (30)
#   BACKUP_KEEP_MIN         — nombre d'archives conservées quoi qu'il arrive (7)

# ===========================================
# PAIEMENTS — ARGENT RÉEL (fermé par défaut)
# ===========================================
# Tant que cette variable ne vaut pas exactement « true », toute configuration
# qui vise la production (FEDAPAY_ENVIRONMENT=live, clé sk_live_…,
# MOMO_TARGET_ENVIRONMENT hors sandbox, URL MoMo de production) est REFUSÉE :
# les routes d'initiation répondent 503 et rien n'est envoyé au fournisseur.
# Le bac à sable fonctionne sans rien activer.
# PAYMENTS_LIVE_ENABLED=false

# ===========================================
# PAIEMENTS — FEDAPAY (Mobile Money MTN/Moov/Celtiis + cartes)
# ===========================================
# Tableau de bord : https://fedapay.com (clés : Workbench → API)
# Webhook à enregistrer : https://votre-domaine.com/api/payments/fedapay/webhook
# FEDAPAY_SECRET_KEY=sk_sandbox_xxx        # sk_live_… en production
# FEDAPAY_WEBHOOK_SECRET=whsec_xxx         # vérification de signature du webhook
# FEDAPAY_ENVIRONMENT=sandbox              # "sandbox" | "live"

# ===========================================
# PAIEMENTS — MTN MOMO (Collection requestToPay + webhook de rapprochement)
# ===========================================
# Portail développeur : https://momodeveloper.mtn.com
# Webhook à enregistrer : https://votre-domaine.com/api/payments/momo/webhook
# Si ces clés sont définies, le Mobile Money passe en MoMo direct ; sinon FedaPay.
# MOMO_WEBHOOK_SECRET=your-hmac-secret
# MOMO_SUBSCRIPTION_KEY=your-subscription-key
# MOMO_API_USER=uuid-api-user
# MOMO_API_KEY=your-api-key
# MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com   # prod: https://proxy.momoapi.mtn.com
# MOMO_TARGET_ENVIRONMENT=sandbox                        # "sandbox" | "mtnbenin" | …
# MOMO_CURRENCY=XOF                                      # EUR en sandbox

# ===========================================
# PAIEMENTS — FLUTTERWAVE / PAYSTACK (webhook générique /api/payments/webhook)
# ===========================================
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxx
# FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# ===========================================
# COMMUNICATION — SMS, WHATSAPP
# ===========================================
# Passerelle SMS (webhook HTTP du fournisseur) :
# SMS_WEBHOOK_URL=https://sms.fournisseur.example/send
# SMS_API_KEY=
# WhatsApp Business (Meta Cloud API) :
# WHATSAPP_PHONE_ID=your-phone-number-id
# WHATSAPP_ACCESS_TOKEN=your-bearer-token

# ===========================================
# IA — SOCLE AUTONOME + CLOUD OPTIONNEL
# ===========================================
# Sans aucune clé : gabarits FR + moteur prédictif local (illimité, gratuit).
# Le cloud améliore uniquement le chat libre et certaines rédactions (best-effort).
# AI_ENABLED=true
# Cascade cloud (ordre de priorité, tous optionnels) :
# AI_PROVIDER=groq,google,openai,anthropic
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_AI_API_KEY=...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Workflows n8n (optionnel) :
# N8N_HOST=https://n8n.votre-domaine.com
# N8N_WEBHOOK_KEY=header-auth-du-noeud-webhook
# N8N_WEBHOOK_SECRET=secret-hmac-signature-payload

# ===========================================
# SUPERVISION
# ===========================================
# Sentry : inactif sans DSN. Serveur : SENTRY_DSN ; navigateur : NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# Alertes performance :
# PERFORMANCE_ALERT_EMAIL=admin@votre-domaine.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ===========================================
# RÉSERVÉ AUX TESTS ET À LA CI — ne jamais définir en production
# ===========================================
# Désactive la validation de démarrage (build de CI, mesures locales).
# SKIP_ENV_VALIDATION=false
# Assouplit les limites de débit (suite E2E qui partage une seule IP).
# RATE_LIMIT_RELAXED=false
# Expose /api/debug/session (en développement uniquement).
# ENABLE_DEBUG_ENDPOINTS=false
