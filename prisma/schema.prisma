// ─── Communication Models ────────────────────────────────────────────────────

model CommunicationLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  recipient String
  channel   String
  type      String   @default("TRANSACTIONAL")
  status    String   @default("PENDING")
  error     String?
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("communication_logs")
}

model CommunicationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  channels        String[] @default(["EMAIL"])
  language        String   @default("fr")
  quietHoursStart String?
  quietHoursEnd   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("communication_preferences")
}

model CommunicationTemplate {
  id        String   @id @default(cuid())
  schoolId  String?
  name      String
  language  String   @default("fr")
  subject   String?
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([name, language])
  @@map("communication_templates")
}

// ─── Wallet · Mobile Money & banques ──────────────────────────────────────
// Models supporting /dashboard/wallet: tracks MTN/Moov/Celtiis MoMo accounts +
// Ecobank/BoA bank balances + scheduled disbursements. Balances are stored in
// minor units of FCFA (no decimals), so plain Int / BigInt are fine.

enum WalletAccountKind {
  BANK
  MTN
  MOOV
  CELTIIS
  CASH
  OTHER
}

enum WalletTxDirection {
  INFLOW
  OUTFLOW
}

enum WalletTxMatchStatus {
  AUTO_MATCHED // rapprochement automatique via référence
  MANUAL_MATCHED // rapproché à la main
  UNMATCHED // à rapprocher
  DISBURSEMENT // décaissement validé (sortie planifiée)
}

enum DisbursementMode {
  AUTO
  MANUAL
}

enum DisbursementStatus {
  PENDING
  VALIDATED
  EXECUTED
  CANCELLED
}

model WalletAccount {
  id          String            @id @default(cuid())
  schoolId    String
  name        String // ex. "Ecobank", "MTN MoMo"
  kind        WalletAccountKind
  accountRef  String? // numéro de compte ou MSISDN
  balanceFcfa BigInt            @default(0)
  colorHex    String? // pour l'UI (optionnel)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  school        School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  disbursements ScheduledDisbursement[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("wallet_accounts")
}

model WalletTransaction {
  id          String              @id @default(cuid())
  schoolId    String
  accountId   String
  direction   WalletTxDirection
  amountFcfa  BigInt // toujours positif, le sens est dans `direction`
  reference   String? // ex. TRX-MTN-882104
  partyName   String? // ex. Famille Hounsou
  detail      String? // ex. Aïcha · trim. 2
  matchStatus WalletTxMatchStatus @default(UNMATCHED)
  matchLabel  String? // libellé court affiché (optionnel)
  occurredAt  DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  account WalletAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([schoolId, occurredAt])
  @@index([accountId, occurredAt])
  @@map("wallet_transactions")
}

model ScheduledDisbursement {
  id          String             @id @default(cuid())
  schoolId    String
  accountId   String? // peut être assigné plus tard
  label       String
  amountFcfa  BigInt
  mode        DisbursementMode   @default(AUTO)
  status      DisbursementStatus @default(PENDING)
  scheduledAt DateTime
  executedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  account WalletAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([schoolId, scheduledAt])
  @@index([status])
  @@map("scheduled_disbursements")
}

// ─── Cagnottes & pots communs ──────────────────────────────────────────────
// Pots communs transparents pour sorties scolaires, cadeaux profs, équipement
// classe. Tout est tracé dans CagnotteJournalEntry (audit public). Le `raised`
// se calcule dynamiquement depuis CagnotteContribution — on ne le stocke pas.

enum CagnotteStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CagnotteJournalKind {
  CREATED
  CONTRIBUTION_PAID
  CONTRIBUTION_REFUNDED
  CLOSED
  DISBURSED
  NOTE
}

model Cagnotte {
  id                   String         @id @default(cuid())
  schoolId             String
  classId              String?
  hostUserId           String?
  title                String
  description          String?
  targetFcfa           BigInt
  deadline             DateTime
  status               CagnotteStatus @default(OPEN)
  expectedParticipants Int? // ex. 28 familles attendues
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  school        School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class         Class?                 @relation(fields: [classId], references: [id], onDelete: SetNull)
  host          User?                  @relation("CagnotteHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  contributions CagnotteContribution[]
  journal       CagnotteJournalEntry[]

  @@index([schoolId, status])
  @@index([deadline])
  @@map("cagnottes")
}

model CagnotteContribution {
  id           String   @id @default(cuid())
  cagnotteId   String
  parentUserId String
  amountFcfa   BigInt
  paymentRef   String?
  paidAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  cagnotte Cagnotte @relation(fields: [cagnotteId], references: [id], onDelete: Cascade)
  parent   User     @relation("CagnotteContributions", fields: [parentUserId], references: [id], onDelete: Cascade)

  @@index([cagnotteId, paidAt])
  @@index([parentUserId])
  @@map("cagnotte_contributions")
}

model CagnotteJournalEntry {
  id          String              @id @default(cuid())
  cagnotteId  String
  kind        CagnotteJournalKind
  actorUserId String?
  amountFcfa  BigInt?
  message     String?
  createdAt   DateTime            @default(now())

  cagnotte Cagnotte @relation(fields: [cagnotteId], references: [id], onDelete: Cascade)
  actor    User?    @relation("CagnotteJournalActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([cagnotteId, createdAt])
  @@map("cagnotte_journal_entries")
}

