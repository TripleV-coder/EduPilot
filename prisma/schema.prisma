model ClimatePulseWeek {
  id               String   @id @default(cuid())
  schoolId         String
  weekLabel        String // S1, S2, etc
  weekStart        DateTime
  averageScore     Float // 0..10
  responses        Int      @default(0)
  pctSafety        Float? // % "je me sens en sécurité"
  pctFriend        Float? // % "j'ai un ami proche"
  pctAdultListens  Float? // % "un adulte m'écoute"
  pctHarassWitness Float? // % "témoin harcèlement"
  createdAt        DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, weekLabel])
  @@index([schoolId, weekStart])
  @@map("climate_pulse_weeks")
}

// ─── Comptabilité OHADA / SYSCOHADA révisé ────────────────────────────────
// Plan SYSCOHADA simplifié + journal débit/crédit + exercices fiscaux.
// `Account` étant déjà pris par NextAuth, on nomme OhadaAccount.

enum OhadaAccountType {
  ASSET // classes 1-3 (immo, stocks)
  LIABILITY // classe 1, 4, 5 (capitaux, dettes)
  INCOME // classe 7
  EXPENSE // classe 6
  EQUITY // classe 1 (capitaux propres)
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model FiscalYear {
  id        String           @id @default(cuid())
  schoolId  String
  label     String // "2025-2026"
  startDate DateTime
  endDate   DateTime
  status    FiscalYearStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([schoolId, label])
  @@index([schoolId, status])
  @@map("fiscal_years")
}

model OhadaAccount {
  id            String           @id @default(cuid())
  schoolId      String
  syscohadaCode String // ex. "411", "70", "6041"
  label         String
  type          OhadaAccountType
  balanceFcfa   BigInt           @default(0)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  debitLines  JournalEntryLine[] @relation("DebitAccount")
  creditLines JournalEntryLine[] @relation("CreditAccount")

  @@unique([schoolId, syscohadaCode])
  @@index([schoolId, type])
  @@map("ohada_accounts")
}

model JournalEntry {
  id           String             @id @default(cuid())
  schoolId     String
  fiscalYearId String
  pieceRef     String // ex. "PIECE-2026-04-0123"
  entryDate    DateTime
  label        String
  status       JournalEntryStatus @default(POSTED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  lines      JournalEntryLine[]

  @@unique([schoolId, pieceRef])
  @@index([schoolId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String  @id @default(cuid())
  journalEntryId  String
  debitAccountId  String?
  creditAccountId String?
  amountFcfa      BigInt
  label           String?

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  debitAccount  OhadaAccount? @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: SetNull)
  creditAccount OhadaAccount? @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: SetNull)

  @@index([journalEntryId])
  @@map("journal_entry_lines")
}

// ─── Notifications vocales multilingues ───────────────────────────────────
// Stocke les campagnes vocales (texte FR + traductions Fon/Yor/Bariba/Dendi
// + URLs audio générées). Dépend d'un provider TTS externe pour
// effectivement produire les fichiers audio (partenariat UAC requis).

enum VoiceLang {
  FR
  FON
  YOR
  BAR
  DIN
}

enum VoiceCampaignStatus {
  DRAFT
  SYNTHESIZED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum VoiceTemplateKind {
  RAPPEL_SCOLARITE
  ABSENCE
  CONVOCATION
  BULLETIN
  LIBRE
}

model VoiceCampaign {
  id            String              @id @default(cuid())
  schoolId      String
  authorUserId  String?
  templateKind  VoiceTemplateKind   @default(LIBRE)
  textFr        String
  status        VoiceCampaignStatus @default(DRAFT)
  audienceSize  Int                 @default(0)
  reachedCount  Int                 @default(0)
  listenedCount Int                 @default(0)
  costFcfa      Int                 @default(0)
  dispatchedAt  DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  school       School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author       User?                      @relation("VoiceCampaignAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  translations VoiceCampaignTranslation[]

  @@index([schoolId, status])
  @@index([dispatchedAt])
  @@map("voice_campaigns")
}

model VoiceCampaignTranslation {
  id          String    @id @default(cuid())
  campaignId  String
  lang        VoiceLang
  text        String
  audioUrl    String?
  narratorRef String?
  createdAt   DateTime  @default(now())

  campaign VoiceCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, lang])
  @@map("voice_campaign_translations")
}

// ─── Benchmark national MEMP ──────────────────────────────────────────────
// Snapshot des indicateurs d'une école comparés au national / département /
// groupe pair. Dépend d'un scraper / partenariat MEMP pour alimenter
// `BenchmarkSnapshotIndicator.nationalValue` etc.

model BenchmarkSnapshot {
  id            String   @id @default(cuid())
  schoolId      String
  capturedAt    DateTime @default(now())
  periodLabel   String // ex. "T2 2025-2026"
  rankNational  Int?
  rankDept      Int?
  rankPeerGroup Int?
  totalNational Int?
  totalDept     Int?
  totalPeer     Int?
  scoreOverall  Float? // 0..100
  createdAt     DateTime @default(now())

  school     School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  indicators BenchmarkSnapshotIndicator[]

  @@index([schoolId, capturedAt])
  @@map("benchmark_snapshots")
}

model BenchmarkSnapshotIndicator {
  id              String  @id @default(cuid())
  snapshotId      String
  label           String // ex. "Réussite BEPC"
  schoolValue     Float
  nationalValue   Float?
  departmentValue Float?
  peerValue       Float?
  unit            String? // "%", "/20", etc.
  tone            String? // hint UI: "success", "warning", "danger"

  snapshot BenchmarkSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("benchmark_snapshot_indicators")
}

// ─────────────────────────────────────────────────────────────
// Transport scolaire (P2.4 — 2026-06-12)
// ─────────────────────────────────────────────────────────────

enum TransportLineStatus {
  ON_TIME
  DELAYED
  INCIDENT
  INACTIVE
}

enum TransportDirection {
  OUTBOUND
  RETURN
  BOTH
}

model TransportLine {
  id        String              @id @default(cuid())
  schoolId  String
  number    String // ex. "L1"
  label     String // ex. "Ganhi → Campus"
  direction TransportDirection  @default(BOTH)
  status    TransportLineStatus @default(ON_TIME)
  note      String?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  buses    Bus[]
  stops    BusRoute[]
  students StudentTransport[]

  @@unique([schoolId, number])
  @@index([schoolId, isActive])
  @@map("transport_lines")
}

model Bus {
  id          String   @id @default(cuid())
  schoolId    String
  lineId      String?
  plateNumber String
  capacity    Int      @default(30)
  driverName  String?
  driverPhone String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  line   TransportLine? @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@unique([schoolId, plateNumber])
  @@index([schoolId, isActive])
  @@map("buses")
}

model BusRoute {
  id            String  @id @default(cuid())
  lineId        String
  name          String // ex. "Carrefour Ganhi"
  order         Int // position de l'arrêt sur la ligne
  scheduledTime String? // "07:15"
  latitude      Float?
  longitude     Float?

  line     TransportLine      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  students StudentTransport[]

  @@unique([lineId, order])
  @@map("bus_routes")
}

model StudentTransport {
  id        String             @id @default(cuid())
  studentId String
  lineId    String
  stopId    String?
  direction TransportDirection @default(BOTH)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  line    TransportLine  @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stop    BusRoute?      @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@unique([studentId, lineId])
  @@index([lineId, isActive])
  @@map("student_transports")
}

// ─────────────────────────────────────────────────────────────
// Observabilité produit (P2.4 — 2026-06-12)
// ─────────────────────────────────────────────────────────────

model PerformanceMetric {
  id        String   @id @default(cuid())
  metric    String // "LCP" | "CLS" | "INP" | "FCP" | "TTFB"
  value     Float
  rating    String? // good | needs-improvement | poor
  pathname  String?
  createdAt DateTime @default(now())

  @@index([metric, createdAt])
  @@index([createdAt])
  @@map("performance_metrics")
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  event     String
  pathname  String?
  userId    String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([createdAt])
  @@map("telemetry_events")
}
